# DialogueLearningAgent 配置样例
# 复制本文件为 .env 并填入实际值即可（.env 已被 gitignore，不会入库）。
# 留空 DLA_LLM__API_KEY 时自动使用内置 FakeLLM（离线模式，开箱即跑）。

# ---- LLM（兼容 OpenAI 协议的任意端点）----
DLA_LLM__API_KEY=
DLA_LLM__BASE_URL=https://api.openai.com/v1
DLA_LLM__MODEL=gpt-4o-mini
# 分析用模型，留空则复用 DLA_LLM__MODEL
# DLA_LLM__ANALYZER_MODEL=
# DLA_LLM__TIMEOUT_SECONDS=60
# DLA_LLM__MAX_RETRIES=2

# ---- 存储 ----
# DLA_DB__PATH=./data/dla.db

# ---- 运行模式 ----
# DLA_MODE__SCENARIO=fixed
# DLA_SCENARIO__DEFAULT=oral_practice

# ---- 人格演进（doc/10，默认关闭，不主动偏离原始人格锚）----
# DLA_PERSONA__AUTO_UPDATE=false

# ---- 上下文自动压缩（doc/11）----
# DLA_CTX__COMPACT_RATIO=0.85
# DLA_CTX__HARD_RATIO=0.95

# 完整字段见 src/dla/config/settings.py
